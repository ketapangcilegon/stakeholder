## 3. Skema Database Supabase & RLS

```sql
-- 1. stakeholder_groups
create table stakeholder_groups (
  id text primary key,
  nama text not null,
  target_responden int not null default 10,
  deskripsi text,
  tone_label text
);

-- 2. dimensi & variabel
create table dimensi (
  id text primary key,
  nama text not null,
  urutan int
);

create table variabel (
  id text primary key,
  id_dimensi text references dimensi(id),
  nama text not null,
  urutan int
);

-- 3. indikator & bank pertanyaan
create table indikator (
  id text primary key,
  id_variabel text references variabel(id),
  kode text not null,
  deskripsi text not null,
  urutan int
);

create table pertanyaan (
  id uuid primary key default gen_random_uuid(),
  id_indikator text references indikator(id),
  id_stakeholder_group text references stakeholder_groups(id),
  teks_pertanyaan text not null,
  keterangan_skala jsonb, -- e.g. {"1": "Sangat Menurun", "5": "Sangat Melimpah"}
  urutan int
);

-- 4. responden
create table responden (
  id uuid primary key default gen_random_uuid(),
  user_id_google text,
  email text,
  nama text not null,
  instansi text not null,
  jabatan text,
  no_hp text,
  id_stakeholder_group text references stakeholder_groups(id),
  is_manual_entry boolean default false,
  status_pengisian text default 'draft', -- 'draft', 'selesai'
  created_at timestamptz default now(),
  updated_at timestamptz default now()
);

-- 5. jawaban
create table jawaban (
  id uuid primary key default gen_random_uuid(),
  id_responden uuid references responden(id) on delete cascade,
  id_pertanyaan uuid references pertanyaan(id),
  id_indikator text references indikator(id),
  skor int check (skor between 1 and 5),
  created_at timestamptz default now(),
  unique (id_responden, id_pertanyaan)
);
```

